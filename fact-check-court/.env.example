# Get a key at https://asi1.ai (Developer / API Keys)
ASI1_API_KEY=your_asi_one_key_here
ASI1_MODEL=asi1

# Optional: Jev decision model, served through Eden AI (https://www.edenai.co).
# Leave empty to skip Jev; the Judge then uses ASI:One's verdict.
EDENAI_API_KEY=
JEV_MODEL=typesafe/jev-latest

# Four DIFFERENT long random phrases. Each one decides that agent's permanent address.
JUDGE_SEED=put-a-long-random-phrase-here-1
PROSECUTOR_SEED=put-a-different-long-random-phrase-2
DEFENDER_SEED=put-a-third-different-long-random-phrase-3
SOURCE_CHECKER_SEED=put-a-fourth-different-long-random-phrase-4
